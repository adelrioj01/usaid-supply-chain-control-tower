createOrReplace

  model Model
    culture: en-US
    defaultPowerBIDataSourceVersion: powerBI_V3
    sourceQueryCulture: en-US
    dataAccessOptions
      legacyRedirects
      returnErrorValuesAsNull

    expression DataRoot = "C:\Users\adurr\miniconda3\PowerBI-Portfolio\data\processed" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

    table DimCountry

      column CountryKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: CountryKey

      column Country
        dataType: string
        summarizeBy: none
        sourceColumn: Country

      partition DimCountry = m
        mode: import
        source =
          let
              Source = Csv.Document(File.Contents(DataRoot & "\DimCountry.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
              #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"CountryKey", Int64.Type}, {"Country", type text}}, "en-US")
          in
              #"Changed Type"

    table DimDate

      column DateKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: DateKey

      column Date
        dataType: dateTime
        formatString: yyyy-MM-dd
        summarizeBy: none
        sourceColumn: Date

      column Year
        dataType: int64
        summarizeBy: none
        sourceColumn: Year

      column Quarter
        dataType: string
        summarizeBy: none
        sourceColumn: Quarter

      column MonthNumber
        dataType: int64
        summarizeBy: none
        sourceColumn: MonthNumber

      column MonthName
        dataType: string
        summarizeBy: none
        sourceColumn: MonthName

      column YearMonth
        dataType: string
        summarizeBy: none
        sourceColumn: YearMonth

      column WeekNumber
        dataType: int64
        summarizeBy: none
        sourceColumn: WeekNumber

      hierarchy Calendar
        level Year
          column: Year
        level Month
          column: MonthName
        level Date
          column: Date

      partition DimDate = m
        mode: import
        source =
          let
              Source = Csv.Document(File.Contents(DataRoot & "\DimDate.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
              #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"DateKey", Int64.Type}, {"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNumber", Int64.Type}, {"MonthName", type text}, {"YearMonth", type text}, {"WeekNumber", Int64.Type}}, "en-US")
          in
              #"Changed Type"

