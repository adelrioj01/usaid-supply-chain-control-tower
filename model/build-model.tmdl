              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"ShippingMethodKey", Int64.Type}, {"ManagedBy", type text}, {"FulfillVia", type text}, {"VendorIncoterm", type text}, {"ShipmentMode", type text}}, "en-US")
