        dataType: string
        summarizeBy: none
        sourceColumn: QualityIssues

      column ShipmentKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ShipmentKey

      partition FactShipmentLines = m
        mode: import
        source =
          let
              Source = Csv.Document(File.Contents(DataRoot & "\FactShipmentLines.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
              #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"ShipmentLineKey", Int64.Type}, {"SourceRowNumber", Int64.Type}, {"ProjectKey", Int64.Type}, {"CountryKey", Int64.Type}, {"VendorKey", Int64.Type}, {"ProductKey", Int64.Type}, {"ManufacturingSiteKey", Int64.Type}, {"ShippingMethodKey", Int64.Type}, {"OrderDateKey", Int64.Type}, {"ScheduledDeliveryDateKey", Int64.Type}, {"ActualDeliveryDateKey", Int64.Type}, {"DeliveryRecordedDateKey", Int64.Type}, {"PurchaseOrderNumber", type text}, {"ASNOrDeliveryNote", type text}, {"FirstLineDesignation", type logical}, {"LineItemQuantity", Int64.Type}, {"LineItemValueUSD", type number}, {"PackPriceUSD", type number}, {"UnitPriceUSD", type number}, {"WeightKg", type number}, {"FreightCostUSD", type number}, {"InsuranceUSD", type number}, {"DeliveryDelayDays", Int64.Type}, {"OrderToDeliveryDays", Int64.Type}, {"OnTimeFlag", type logical}, {"LateFlag", type logical}, {"WeightAvailableFlag", type logical}, {"FreightCostAvailableFlag", type logical}, {"QualityIssueCount", Int64.Type}, {"QualityIssues", type text}, {"ShipmentKey", Int64.Type}}, "en-US")
          in
              #"Changed Type"

    table FactShipments

      column ShipmentKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ShipmentKey

      column ASNOrDeliveryNote
        dataType: string
        summarizeBy: none
        sourceColumn: ASNOrDeliveryNote

      column ProjectKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ProjectKey

      column CountryKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: CountryKey

      column VendorKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: VendorKey

      column ManufacturingSiteKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ManufacturingSiteKey

      column ShippingMethodKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ShippingMethodKey

      column OrderDateKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: OrderDateKey

      column ScheduledDeliveryDateKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ScheduledDeliveryDateKey

      column ActualDeliveryDateKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: ActualDeliveryDateKey

      column DeliveryRecordedDateKey
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: DeliveryRecordedDateKey

      column PurchaseOrderNumber
        dataType: string
        summarizeBy: none
        sourceColumn: PurchaseOrderNumber

      column ShipmentLineCount
        dataType: int64
        summarizeBy: none
        sourceColumn: ShipmentLineCount

      column LineItemQuantity
        dataType: int64
        summarizeBy: none
        sourceColumn: LineItemQuantity

      column LineItemValueUSD
        dataType: double
        formatString: #,0.00
        summarizeBy: none
        sourceColumn: LineItemValueUSD

      column InsuranceUSD
        dataType: double
        formatString: #,0.00
        summarizeBy: none
        sourceColumn: InsuranceUSD

      column WeightKg
        dataType: double
        formatString: #,0.00
        summarizeBy: none
        sourceColumn: WeightKg

      column FreightCostUSD
        dataType: double
        formatString: #,0.00
        summarizeBy: none
        sourceColumn: FreightCostUSD

      column DeliveryDelayDays
        dataType: int64
        summarizeBy: none
        sourceColumn: DeliveryDelayDays

      column OrderToDeliveryDays
        dataType: int64
        summarizeBy: none
        sourceColumn: OrderToDeliveryDays

      column OnTimeFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: OnTimeFlag

      column LateFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: LateFlag

      column FirstLineDesignation
        dataType: boolean
        summarizeBy: none
        sourceColumn: FirstLineDesignation

      column AttributeConflictCount
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: AttributeConflictCount

      column QualityIssueCount
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: QualityIssueCount

      partition FactShipments = m
        mode: import
        source =
          let
              Source = Csv.Document(File.Contents(DataRoot & "\FactShipments.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
              #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"ShipmentKey", Int64.Type}, {"ASNOrDeliveryNote", type text}, {"ProjectKey", Int64.Type}, {"CountryKey", Int64.Type}, {"VendorKey", Int64.Type}, {"ManufacturingSiteKey", Int64.Type}, {"ShippingMethodKey", Int64.Type}, {"OrderDateKey", Int64.Type}, {"ScheduledDeliveryDateKey", Int64.Type}, {"ActualDeliveryDateKey", Int64.Type}, {"DeliveryRecordedDateKey", Int64.Type}, {"PurchaseOrderNumber", type text}, {"ShipmentLineCount", Int64.Type}, {"LineItemQuantity", Int64.Type}, {"LineItemValueUSD", type number}, {"InsuranceUSD", type number}, {"WeightKg", type number}, {"FreightCostUSD", type number}, {"DeliveryDelayDays", Int64.Type}, {"OrderToDeliveryDays", Int64.Type}, {"OnTimeFlag", type logical}, {"LateFlag", type logical}, {"FirstLineDesignation", type logical}, {"AttributeConflictCount", Int64.Type}, {"QualityIssueCount", Int64.Type}}, "en-US")
          in
              #"Changed Type"

      measure 'Shipments' = COUNTROWS ( FactShipments )
        formatString: #,0
        displayFolder: 01 Volume and value

      measure 'Shipment Lines' = COUNTROWS ( FactShipmentLines )
        formatString: #,0
        displayFolder: 01 Volume and value

      measure 'Line Item Quantity' = SUM ( FactShipmentLines[LineItemQuantity] )
        formatString: #,0
        displayFolder: 01 Volume and value

      measure 'Commodity Value' = SUM ( FactShipmentLines[LineItemValueUSD] )
        formatString: $#,0;($#,0)
        displayFolder: 01 Volume and value

      measure 'Insurance Value' = SUM ( FactShipmentLines[InsuranceUSD] )
        formatString: $#,0;($#,0)
        displayFolder: 01 Volume and value

      measure 'First Line Commodity Value' = CALCULATE ( [Commodity Value], FactShipmentLines[FirstLineDesignation] = TRUE () )
        formatString: $#,0;($#,0)
        displayFolder: 01 Volume and value

      measure 'First Line Value Share' = DIVIDE ( [First Line Commodity Value], [Commodity Value] )
        formatString: 0.0%
        displayFolder: 01 Volume and value

      measure 'Delivery Eligible Shipments' = CALCULATE ( [Shipments], NOT ISBLANK ( FactShipments[OnTimeFlag] ) )
        formatString: #,0
        displayFolder: 02 Delivery performance

      measure 'On Time Shipments' = CALCULATE ( [Shipments], FactShipments[OnTimeFlag] = TRUE () )
        formatString: #,0
        displayFolder: 02 Delivery performance

      measure 'Late Shipments' = CALCULATE ( [Shipments], FactShipments[LateFlag] = TRUE () )
        formatString: #,0
        displayFolder: 02 Delivery performance

      measure 'On Time Delivery Rate' = DIVIDE ( [On Time Shipments], [Delivery Eligible Shipments] )
        formatString: 0.0%
        displayFolder: 02 Delivery performance

      measure 'Late Shipment Rate' = DIVIDE ( [Late Shipments], [Delivery Eligible Shipments] )
        formatString: 0.0%
        displayFolder: 02 Delivery performance

      measure 'Average Late Days' = CALCULATE ( AVERAGE ( FactShipments[DeliveryDelayDays] ), FactShipments[LateFlag] = TRUE () )
        formatString: 0.0
        displayFolder: 02 Delivery performance

      measure 'Average Order to Delivery Days' = AVERAGE ( FactShipments[OrderToDeliveryDays] )
        formatString: 0.0
        displayFolder: 02 Delivery performance

      measure 'P90 Late Days' = PERCENTILEX.INC ( FILTER ( FactShipments, FactShipments[LateFlag] = TRUE () ), FactShipments[DeliveryDelayDays], 0.9 )
        formatString: 0.0
        displayFolder: 02 Delivery performance

      measure 'Freight Cost' = SUM ( FactShipments[FreightCostUSD] )
        formatString: $#,0;($#,0)
        displayFolder: 03 Freight efficiency

      measure 'Shipment Weight Kg' = SUM ( FactShipments[WeightKg] )
        formatString: #,0
        displayFolder: 03 Freight efficiency

      measure 'Freight Cost per Kg' = DIVIDE ( CALCULATE ( [Freight Cost], NOT ISBLANK ( FactShipments[WeightKg] ) ), CALCULATE ( [Shipment Weight Kg], NOT ISBLANK ( FactShipments[FreightCostUSD] ) ) )
        formatString: $0.00
        displayFolder: 03 Freight efficiency

      measure 'Logistics Cost Rate' = DIVIDE ( [Freight Cost], [Commodity Value] )
        formatString: 0.0%
        displayFolder: 03 Freight efficiency

      measure 'Freight Available Shipments' = CALCULATE ( [Shipments], NOT ISBLANK ( FactShipments[FreightCostUSD] ) )
        formatString: #,0
        displayFolder: 03 Freight efficiency

      measure 'Weight Available Shipments' = CALCULATE ( [Shipments], NOT ISBLANK ( FactShipments[WeightKg] ) )
        formatString: #,0
        displayFolder: 03 Freight efficiency

      measure 'Freight Coverage Rate' = DIVIDE ( [Freight Available Shipments], [Shipments] )
        formatString: 0.0%
        displayFolder: 03 Freight efficiency

      measure 'Weight Coverage Rate' = DIVIDE ( [Weight Available Shipments], [Shipments] )
        formatString: 0.0%
        displayFolder: 03 Freight efficiency

      measure 'Late Commodity Value' = CALCULATE ( [Commodity Value], FactShipmentLines[LateFlag] = TRUE () )
        formatString: $#,0;($#,0)
        displayFolder: 04 Risk and prioritization

      measure 'Late Value Share' = DIVIDE ( [Late Commodity Value], [Commodity Value] )
        formatString: 0.0%
        displayFolder: 04 Risk and prioritization

      measure 'Delivery Risk Status' = SWITCH ( TRUE (), [Delivery Eligible Shipments] = 0, "No eligible shipments", [On Time Delivery Rate] >= 0.95, "Target met", [On Time Delivery Rate] >= 0.85, "Monitor", "Action required" )
        displayFolder: 04 Risk and prioritization

      measure 'Rows with Quality Issues' = CALCULATE ( [Shipment Lines], FactShipmentLines[QualityIssueCount] > 0 )
        formatString: #,0
        displayFolder: 05 Data quality

      measure 'Shipment Attribute Conflicts' = SUM ( FactShipments[AttributeConflictCount] )
        formatString: #,0
        displayFolder: 05 Data quality

      measure 'Shipments YTD' = TOTALYTD ( [Shipments], DimDate[Date] )
        formatString: #,0
        displayFolder: 90 Time intelligence

      measure 'On Time Delivery Rate PY' = CALCULATE ( [On Time Delivery Rate], DATEADD ( DimDate[Date], -1, YEAR ) )
        formatString: 0.0%
        displayFolder: 90 Time intelligence

      measure 'On Time Rate YoY Change' = [On Time Delivery Rate] - [On Time Delivery Rate PY]
        formatString: 0.0%
        displayFolder: 90 Time intelligence

    relationship FactShipments_Country
      fromColumn: FactShipments.CountryKey
      toColumn: DimCountry.CountryKey

    relationship FactLines_Country
      fromColumn: FactShipmentLines.CountryKey
      toColumn: DimCountry.CountryKey

    relationship FactShipments_Vendor
      fromColumn: FactShipments.VendorKey
      toColumn: DimVendor.VendorKey

    relationship FactLines_Vendor
      fromColumn: FactShipmentLines.VendorKey
      toColumn: DimVendor.VendorKey

    relationship FactShipments_Project
      fromColumn: FactShipments.ProjectKey
      toColumn: DimProject.ProjectKey

    relationship FactLines_Project
      fromColumn: FactShipmentLines.ProjectKey
      toColumn: DimProject.ProjectKey

    relationship FactShipments_Site
      fromColumn: FactShipments.ManufacturingSiteKey
      toColumn: DimManufacturingSite.ManufacturingSiteKey

    relationship FactLines_Site
      fromColumn: FactShipmentLines.ManufacturingSiteKey
      toColumn: DimManufacturingSite.ManufacturingSiteKey

    relationship FactShipments_Method
      fromColumn: FactShipments.ShippingMethodKey
      toColumn: DimShippingMethod.ShippingMethodKey

    relationship FactLines_Method
      fromColumn: FactShipmentLines.ShippingMethodKey
      toColumn: DimShippingMethod.ShippingMethodKey

    relationship FactLines_Product
      fromColumn: FactShipmentLines.ProductKey
      toColumn: DimProduct.ProductKey

    relationship FactShipments_ActualDate
      fromColumn: FactShipments.ActualDeliveryDateKey
      toColumn: DimDate.DateKey

    relationship FactLines_ActualDate
      fromColumn: FactShipmentLines.ActualDeliveryDateKey
      toColumn: DimDate.DateKey

    relationship FactShipments_OrderDate
      fromColumn: FactShipments.OrderDateKey
      toColumn: DimDate.DateKey
      isActive: false

    relationship FactShipments_ScheduledDate
      fromColumn: FactShipments.ScheduledDeliveryDateKey
      toColumn: DimDate.DateKey
      isActive: false

    relationship FactShipments_RecordedDate
      fromColumn: FactShipments.DeliveryRecordedDateKey
      toColumn: DimDate.DateKey
      isActive: false

    relationship FactLines_OrderDate
      fromColumn: FactShipmentLines.OrderDateKey
      toColumn: DimDate.DateKey
      isActive: false

    relationship FactLines_ScheduledDate
      fromColumn: FactShipmentLines.ScheduledDeliveryDateKey
      toColumn: DimDate.DateKey
      isActive: false

    relationship FactLines_RecordedDate
      fromColumn: FactShipmentLines.DeliveryRecordedDateKey
      toColumn: DimDate.DateKey
      isActive: false
