      column InsuranceUSD
        dataType: double
        formatString: #,0.00
        summarizeBy: none
        sourceColumn: InsuranceUSD

      column DeliveryDelayDays
        dataType: int64
        summarizeBy: none
        sourceColumn: DeliveryDelayDays

      column OrderToDeliveryDays
        dataType: int64
        summarizeBy: none
        sourceColumn: OrderToDeliveryDays

      column OnTimeFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: OnTimeFlag

      column LateFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: LateFlag

      column WeightAvailableFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: WeightAvailableFlag

      column FreightCostAvailableFlag
        dataType: boolean
        summarizeBy: none
        sourceColumn: FreightCostAvailableFlag

      column QualityIssueCount
        dataType: int64
        isHidden
        summarizeBy: none
        sourceColumn: QualityIssueCount

