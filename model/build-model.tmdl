              #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"ProductKey", Int64.Type}, {"ProductGroup", type text}, {"SubClassification", type text}, {"ItemDescription", type text}, {"MoleculeOrTestType", type text}, {"Brand", type text}, {"Dosage", type text}, {"DosageForm", type text}, {"UnitsPerPack", Int64.Type}}, "en-US")
          in
